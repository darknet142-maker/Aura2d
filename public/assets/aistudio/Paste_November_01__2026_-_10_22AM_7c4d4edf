    async function encryptTrackToSandbox(track) {
      showToast('Découpage en chunks & Chiffrement AES-256-GCM...', 'bg-amber-400');

      // Animation de l'anneau de téléchargement
      drmProgressCircle.style.strokeDashoffset = '35';
      await new Promise(r => setTimeout(r, 450));
      drmProgressCircle.style.strokeDashoffset = '0';

      // Génération d'une vraie clé AES-256-GCM NON-EXTRACTIBLE (extractable: false)
      const key = await window.crypto.subtle.generateKey(
        { name: 'AES-GCM', length: 256 },
        false, // Impossible d'exporter la clé hors du navigateur/application
        ['encrypt', 'decrypt']
      );

      const iv = window.crypto.getRandomValues(new Uint8Array(12));
      const encoder = new TextEncoder();
      const rawAudioPayload = encoder.encode(
        `STREAM_AUDIO_PCM_FRAME::${track.id}::${track.title}::${Date.now()}::PROTECTED_MASTER`
      );

      const cipherBuffer = await window.crypto.subtle.encrypt(
        { name: 'AES-GCM', iv },
        key,
        rawAudioPayload
      );

      drmVault[track.id] = {
        key,
        iv,
        cipherBytes: new Uint8Array(cipherBuffer),
        corrupted: false,
        timestamp: new Date().toLocaleTimeString()
      };

      updateDrmUI();
      showToast('Titre verrouillé dans le Coffre DRM (Clé non-extractible)', 'bg-emerald-400');
