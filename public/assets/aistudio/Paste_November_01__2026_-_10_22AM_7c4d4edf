    function formatTime(sec) {
      const s = Math.max(0, Math.floor(sec));
      const m = Math.floor(s / 60);
      const r = s % 60;
      return `${m}:${r < 10 ? '0' : ''}${r}`;
    }

    function showToast(msg, color = 'bg-emerald-400') {
      const toast = document.getElementById('toast');
      const dot = document.getElementById('toastDot');
      document.getElementById('toastMsg').textContent = msg;
      dot.className = `w-2 h-2 rounded-full ${color}`;
      toast.classList.remove('opacity-0');
      toast.classList.add('opacity-100');
      clearTimeout(toast._t);
      toast._t = setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0');
      }, 2800);
    }

    // Rendu du Carrousel 3D
    function renderCarousel() {
      carouselStage.innerHTML = '';
      tracks.forEach((t, idx) => {
        const card = document.createElement('div');
        card.className = `cover-card ${getCardClass(idx)}`;
        card.innerHTML = t.coverSvg;
        card.addEventListener('click', () => {
          if (idx !== activeIndex) {
            activeIndex = idx;
            updateUI();
          }
        });
        carouselStage.appendChild(card);
      });
    }

    function getCardClass(idx) {
      const total = tracks.length;
      const diff = (idx - activeIndex + total) % total;
      if (diff === 0) return 'active';
      if (diff === 1) return 'next';
      if (diff === total - 1) return 'prev';
      return diff < total / 2 ? 'hidden-right' : 'hidden-left';
    }

    function updateUI() {
      const cards = carouselStage.querySelectorAll('.cover-card');
      cards.forEach((c, idx) => {
        c.className = `cover-card ${getCardClass(idx)}`;
      });

      const t = tracks[activeIndex];
      ambientBg.style.setProperty('--bg-glow', t.glow);
      trackTitle.textContent = t.title;
      trackArtist.textContent = t.artist;
      trackRank.textContent = t.rank;
      trackTrend.textContent = t.trend;
      trackPlays.textContent = t.plays;
      trackTimeAgo.textContent = t.ago;
      likeIcon.classList.toggle('text-rose-500', t.liked);
      likeIcon.classList.toggle('text-white/35', !t.liked);

      updateScrubber();
      updateDrmUI();
    }

    function updateScrubber() {
      const t = tracks[activeIndex];
      const pct = (t.currentTime / t.duration) * 100;
      scrubberFill.style.width = `${Math.min(100, Math.max(0, pct))}%`;
      currentTimeEl.textContent = formatTime(t.currentTime);
      totalTimeEl.textContent = formatTime(t.duration);
    }

    // Moteur Web Audio Synthétisé
    function startAudioEngine() {
      const t = tracks[activeIndex];
      const record = drmVault[t.id];
      if (record && record.corrupted) {
        showToast('Lecture impossible : Fichier autodétruit suite à une violation DRM', 'bg-rose-500');
        stopAudioEngine();
        return;
      }

      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();

      clearInterval(synthInterval);
      let step = 0;
      synthInterval = setInterval(() => {
        if (!isPlaying) return;
        const track = tracks[activeIndex];
        const freq = track.notes[step % track.notes.length];
        step++;

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

        gain.gain.setValueAtTime(0.001, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.12, audioCtx.currentTime + 0.06);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.48);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.5);
      }, 520);

      clearInterval(progressTimer);
      progressTimer = setInterval(() => {
        if (!isPlaying) return;
        const track = tracks[activeIndex];
        track.currentTime += 1;
        if (track.currentTime >= track.duration) {
          if (isRepeat) {
            track.currentTime = 0;
          } else {
            nextTrack();
          }
        }
        updateScrubber();
      }, 1000);
    }

    function stopAudioEngine() {
      isPlaying = false;
      clearInterval(synthInterval);
      clearInterval(progressTimer);
